---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RouteFlix - Iniciar sesión">
  <div class="auth-screen">
    <a href="/" class="auth-logo">RouteFlix</a>

    <div class="auth-card">
      <h1>Iniciar sesión</h1>

      <div id="auth-error" class="auth-error" style="display:none;"></div>
      <div id="auth-success" class="auth-success" style="display:none;"></div>

      <form id="login-form" autocomplete="on">
        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="tu@email.com"
            required
            autocomplete="email"
          />
        </div>

        <div class="form-group" id="password-group">
          <label for="password">Contrasena</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            required
            autocomplete="current-password"
          />
        </div>

        <div class="form-group" id="otp-group" style="display:none;">
          <label for="otp-code">Codigo OTP</label>
          <input
            type="text"
            id="otp-code"
            name="otp-code"
            placeholder="123456"
            inputmode="numeric"
            pattern="[0-9]{6,8}"
            maxlength="8"
            autocomplete="one-time-code"
            disabled
          />
        </div>

        <button type="submit" id="login-btn" class="auth-btn">
          <span id="btn-text">Iniciar sesion</span>
          <span id="btn-spinner" class="spinner" style="display:none;"></span>
        </button>
        <button type="button" id="resend-otp-btn" class="auth-secondary-btn" style="display:none;">
          Reenviar codigo
        </button>
      </form>

      <p class="auth-footer">
        ¿No tenés cuenta?
        <a href="/register">Registrate</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  import { requestEmailOtp, signInWithPasswordAndRequestOtp, verifyEmailOtp } from '../lib/auth.js';

  const form = document.getElementById('login-form');
  const errorBox = document.getElementById('auth-error');
  const successBox = document.getElementById('auth-success');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const emailInput = document.getElementById('email');
  const passwordGroup = document.getElementById('password-group');
  const passwordInput = document.getElementById('password');
  const otpGroup = document.getElementById('otp-group');
  const otpInput = document.getElementById('otp-code');
  const resendOtpBtn = document.getElementById('resend-otp-btn');
  const REDIRECT_DELAY = 800;

  let isOtpStep = false;

  function setLoading(isLoading) {
    btnText.style.display = isLoading ? 'none' : 'inline';
    btnSpinner.style.display = isLoading ? 'inline-block' : 'none';
    resendOtpBtn.disabled = isLoading;
  }

  function setOtpStep(enabled) {
    isOtpStep = enabled;
    otpGroup.style.display = enabled ? 'block' : 'none';
    otpInput.disabled = !enabled;
    otpInput.required = enabled;
    emailInput.readOnly = enabled;
    passwordGroup.style.display = enabled ? 'none' : 'block';
    passwordInput.disabled = enabled;
    passwordInput.required = !enabled;
    btnText.textContent = enabled ? 'Verificar codigo' : 'Iniciar sesion';
    resendOtpBtn.style.display = enabled ? 'block' : 'none';

    if (enabled) {
      otpInput.focus();
    }
  }

  async function sendOtpCode() {
    const email = emailInput.value.trim();
    await requestEmailOtp(email);
    sessionStorage.setItem('routeflixPendingOtpEmail', email);
    successBox.textContent = 'Te enviamos un codigo por email. Ingresalo completo para continuar.';
    successBox.style.display = 'block';
    setOtpStep(true);
  }

  const params = new URLSearchParams(window.location.search);
  const pendingEmail = sessionStorage.getItem('routeflixPendingOtpEmail');

  if (params.get('registered') === '1' && pendingEmail) {
    emailInput.value = pendingEmail;
    successBox.textContent = 'Registrado correctamente. Ingresa tu contrasena para recibir el codigo OTP.';
    successBox.style.display = 'block';
  } else if (params.get('registered') === '1') {
    successBox.textContent = 'Registrado correctamente. Ingresa tu contrasena para recibir el codigo OTP.';
    successBox.style.display = 'block';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.style.display = 'none';
    successBox.style.display = 'none';

    if (!emailInput.reportValidity()) {
      return;
    }

    setLoading(true);

    try {
      const email = emailInput.value.trim();

      if (!isOtpStep) {
        await signInWithPasswordAndRequestOtp(email, passwordInput.value);
        sessionStorage.setItem('routeflixPendingOtpEmail', email);
        successBox.textContent = 'Contrasena correcta. Te enviamos un codigo por email.';
        successBox.style.display = 'block';
        setOtpStep(true);
        return;
      }

      const token = otpInput.value.trim();

      if (!/^\d{6,8}$/.test(token)) {
        errorBox.textContent = 'Ingresa el codigo OTP completo.';
        errorBox.style.display = 'block';
        return;
      }

      await verifyEmailOtp(email, token);
      sessionStorage.removeItem('routeflixPendingOtpEmail');
      successBox.textContent = 'Sesion iniciada. Redirigiendo...';
      successBox.style.display = 'block';
      setTimeout(() => { window.location.href = '/catalog'; }, REDIRECT_DELAY);
    } catch (err) {
      errorBox.textContent = err.message || 'Error al validar el codigo. Intenta de nuevo.';
      errorBox.style.display = 'block';
    } finally {
      setLoading(false);
    }
  });

  resendOtpBtn?.addEventListener('click', async () => {
    errorBox.style.display = 'none';
    successBox.style.display = 'none';
    setLoading(true);

    try {
      await sendOtpCode();
    } catch (err) {
      errorBox.textContent = err.message || 'No se pudo reenviar el codigo. Intenta de nuevo.';
      errorBox.style.display = 'block';
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
  .auth-screen {
    min-height: 100vh;
    background: #141414;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
  }

  .auth-logo {
    position: absolute;
    top: 2rem;
    left: 2rem;
    font-size: 2rem;
    font-weight: 900;
    color: #e50914;
    text-decoration: none;
    letter-spacing: -1px;
  }

  .auth-card {
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 3rem 3.5rem;
    width: 100%;
    max-width: 420px;
    backdrop-filter: blur(12px);
  }

  h1 {
    color: #fff;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  label {
    display: block;
    color: #aaa;
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  input {
    width: 100%;
    background: #333;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    color: #fff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  input:focus {
    border-color: #e50914;
    background: #3a3a3a;
  }

  .auth-btn {
    width: 100%;
    background: #e50914;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 1rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: background 0.2s, transform 0.1s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .auth-btn:hover { background: #c1121f; }
  .auth-btn:active { transform: scale(0.98); }

  .auth-secondary-btn {
    width: 100%;
    background: transparent;
    color: #e50914;
    border: none;
    padding: 0.85rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .auth-secondary-btn:hover { text-decoration: underline; }
  .auth-secondary-btn:disabled {
    cursor: default;
    opacity: 0.7;
    text-decoration: none;
  }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .auth-error {
    background: rgba(229, 9, 20, 0.15);
    border: 1px solid #e50914;
    color: #ff6b6b;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }

  .auth-success {
    background: rgba(40, 167, 69, 0.15);
    border: 1px solid #28a745;
    color: #5cb85c;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }

  .auth-footer {
    color: #aaa;
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.9rem;
  }

  .auth-footer a {
    color: #e50914;
    text-decoration: none;
    font-weight: 600;
  }

  .auth-footer a:hover { text-decoration: underline; }
</style>
